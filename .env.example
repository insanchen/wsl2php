# Copy to .env, then adjust only what the machine needs. Values are data, not shell code.
SERVER_NAME="localhost"
SERVER_ALIAS=""
SERVER_ROOT="/var/www"
SERVER_APP="html"
SERVER_TZ="Asia/Jakarta"

# Current development selection. Change this list for a project that needs different PHP versions.
INSTALL_PHP=Y
INSTALL_PHP_VERSION="7.4 8.3 8.4 8.5"

# Pick exactly one web server.
INSTALL_NGINX=Y
INSTALL_APACHE=N
INSTALL_MARIADB=Y
INSTALL_REDIS=Y
INSTALL_PHPMYADMIN=Y
INSTALL_NODEJS=Y
INSTALL_COMPOSER=Y
INSTALL_UV=Y

# Developer conveniences; safe to disable on a lean production server.
INSTALL_DEV_TOOLS=Y
INSTALL_SHELL_CUSTOMIZATION=N

# Private extension hook. It is skipped automatically when no private hook exists.
INSTALL_ADDONS=Y

# Optional local-only database accounts. Leave blank to create none.
INSTALL_DB_NAMES=""
INSTALL_DB_USER=""
INSTALL_DB_PASSWORD=""
INSTALL_DB_POWER_USER=""
INSTALL_DB_POWER_PASS=""
